;;; The following lines added by ql:add-to-init-file:
#-quicklisp
(let ((quicklisp-init (pathname "Z:/hmj/Sourcery/quicklisp/setup.lisp")))
  (when (probe-file quicklisp-init)
    (load quicklisp-init)))

;;; Create swank server
;;; Set the following variable in the Slimv before connecting to the server
;;;        let g:swank_host = '192.168.56.2'
(load (pathname "Z:/hmj/.vim/bundle/slimv/slime/swank-loader.lisp"))
(swank-loader:init)
(define-action "Initialize LispWorks Tools"
               "Create swank server"
               #'(lambda (screen)
                   (declare (ignore screen))
                   (swank:create-server :interface "0.0.0.0" :port 4005 :dont-close t))
               :after "Run the environment start up functions"
               :once)
