;;;;
;;;; vim: filetype=lisp
;;;;
;;;; This is the %USERPROFILE%\.lispworks and/or $HOME/.sbclrc
;;;;

(let ((homedir
        #+(or windows mswindows os-windows win32)
        #P"Z:/hmj/"
        #+unix
        (user-homedir-pathname)))
  #-quicklisp
  (load (merge-pathnames "Sourcery/quicklisp/setup.lisp" homedir))
  (load (merge-pathnames ".vim/bundle/slimv/slime/swank-loader.lisp" homedir))
  )

(swank-loader:init)
(let ((create-swank-server (lambda ()
                             (swank:create-server :interface "0.0.0.0" :port 4005 :dont-close t))))
  #+lispworks
  (define-action "Initialize LispWorks Tools"
                 "Create swank server"
                 #'(lambda (screen)
                     (declare (ignore screen))
                     (funcall create-swank-server))
                 :after "Run the environment start up functions"
                 :once)
  #-lispworks
  (funcall create-swank-server)
  )

