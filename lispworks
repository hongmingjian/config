;;;;
;;;; vim: filetype=lisp
;;;;
;;;; This is the %USERPROFILE%\.lispworks and/or $HOME/.sbclrc
;;;;

(defparameter *homedir*
  #+(or windows mswindows os-windows win32) #P"Z:/hmj/"
  #+unix (user-homedir-pathname))

#-quicklisp
(let ((quicklisp-init (merge-pathnames "Sourcery/quicklisp/setup.lisp" *homedir*)))
  (when (probe-file quicklisp-init)
    (load quicklisp-init)))

#-swank
(let ((swank-init (merge-pathnames ".vim/bundle/slimv/slime/swank-loader.lisp" *homedir*)))
  (if (probe-file swank-init)
      (progn (load swank-init)
             (funcall (read-from-string "swank-loader:init")))
      (progn (ql:quickload :swank)
             (funcall (read-from-string "swank:swank-require") :swank-repl))))

(let ((create-swank-server (lambda ()
                             (swank:create-server :interface "0.0.0.0" :port 4005 :dont-close t))))
  #+lispworks
  (define-action "Initialize LispWorks Tools"
                 "Create swank server"
                 #'(lambda (screen)
                     (declare (ignore screen))
                     (funcall create-swank-server))
                 :after "Run the environment start up functions"
                 :once)
  #-lispworks
  (funcall create-swank-server)
  )

