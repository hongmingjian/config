		dnsDomainIs(host, ".theguardian.com") ||
		dnsDomainIs(host, ".reuters.com") ||
		dnsDomainIs(host, ".theatlantic.com") ||
		dnsDomainIs(host, ".foreignaffairs.com") ||
		dnsDomainIs(host, ".ti.me") ||
		dnsDomainIs(host, ".time.com") ||
		dnsDomainIs(host, ".timeinc.net") ||
		dnsDomainIs(host, ".apnews.com") ||
		dnsDomainIs(host, ".ap.org") ||
		dnsDomainIs(host, ".aptv.org") ||
		dnsDomainIs(host, ".apimages.com") ||
		dnsDomainIs(host, ".forbes.com") ||
		dnsDomainIs(host, ".bloomberg.com") ||
		dnsDomainIs(host, ".trib.al") ||
		dnsDomainIs(host, ".businessweek.com") ||
		dnsDomainIs(host, ".businessinsider.com") ||
