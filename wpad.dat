function FindProxyForURL(url, host)
{
	host = host.toLowerCase();

	//10.x.x.x / 192.168.x.x / 172.16.x.x-172.31.x.x / 127.x.x.x
	var regexPrivateIp = /^(10\.\d+\.\d+\.\d+|192\.168\.\d+\.\d+|172\.(1[6-9]|2\d|3[0-1])\.\d+\.\d+|127\.\d+\.\d+\.\d+)$/;

	if (
		isPlainHostName(host) ||

		// Prevent DNS leakage
		dnsDomainIs(host, ".local") ||
		dnsDomainIs(host, ".lan") ||
		dnsDomainIs(host, ".home.arpa") ||

		// Private IP
		regexPrivateIp.test(host) ||

		false)
		return "DIRECT";
	    
	return "PROXY 192.168.1.1:8118";
}

