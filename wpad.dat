		dnsDomainIs(host, ".b-cdn.net") ||
		dnsDomainIs(host, ".bootstrapcdn.com") ||

		// Google
		dnsDomainIs(host, ".g.co") ||
		dnsDomainIs(host, ".goo.gl") ||
		dnsDomainIs(host, ".goo.gle") ||
		host.match(/\.google\./) ||
