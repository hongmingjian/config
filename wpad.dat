function FindProxyForURL(url, host)
{
	var direct = "DIRECT";
	var tunnel = "PROXY 192.168.1.1:8118";

	if (isPlainHostName(host))
		return direct;

	// for DEBUG
	//direct = "PROXY 192.168.1.1:8228";

	host = host.toLowerCase();
	host = "." + host;

	// Shortcuts
	if (
		dnsDomainIs(host, ".cn") ||
		dnsDomainIs(host, ".aliapp.org") ||

		false)
		return direct;

	// Common rules
	if (
		// Top level domains
		dnsDomainIs(host, ".org") ||
