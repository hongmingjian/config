		dnsDomainIs(host, ".tmagazine.com") ||
		dnsDomainIs(host, ".wsj.com") ||
		dnsDomainIs(host, ".wsj.net") ||
		dnsDomainIs(host, ".ft.com") ||
		dnsDomainIs(host, ".ftchinese.com") ||
		dnsDomainIs(host, ".economist.com") ||
