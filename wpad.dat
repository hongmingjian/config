function FindProxyForURL(url, host)
{
	var china = "DIRECT";
	var world = "PROXY 192.168.1.1:8118";

	// for DEBUG
 	//china = "PROXY 192.168.1.1:8228";

	host = host.toLowerCase();
	host = "." + host;

	// Exceptions
	if (
		dnsDomainIs(host, ".aliapp.org") ||

		false)
		return china;

	// Common rules
	if (
		// Top level domains
		dnsDomainIs(host, ".org") ||
