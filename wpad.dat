		dnsDomainIs(host, ".xyz") ||
		dnsDomainIs(host, ".space") ||
		dnsDomainIs(host, ".digital") ||
		dnsDomainIs(host, ".report") ||

		// DNS
		dnsDomainIs(host, ".akadns.net") ||
		dnsDomainIs(host, ".cloudflare-dns.com") ||
		dnsDomainIs(host, ".opendns.com") ||
		dnsDomainIs(host, ".quad9.net") ||
		dnsDomainIs(host, ".dyndns.org") ||

		// Meta
		shExpMatch(host, "*.facebook.*") ||
		dnsDomainIs(host, ".fbcdn.net") ||
		dnsDomainIs(host, ".fb.com") ||
		dnsDomainIs(host, ".instagram.com") ||
		dnsDomainIs(host, ".cdninstagram.com") ||
		dnsDomainIs(host, ".instagr.am") ||
		shExpMatch(host, "*.whatsapp.*") ||
		dnsDomainIs(host, ".meta.com") ||
		dnsDomainIs(host, ".thefacebook.com") ||
		dnsDomainIs(host, ".fbsbx.com") ||

		// Privoxy
 		dnsDomainIs(host, ".p.p") ||

 		false)
 		return tunnel;
	return direct;
}

