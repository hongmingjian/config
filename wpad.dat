function FindProxyForURL(url, host)
{
	var direct = "DIRECT";

	if (isPlainHostName(host))
		return direct;

	var tunnel = "PROXY 192.168.1.1:8118";
	//direct = "PROXY 192.168.1.1:8228"; //for DEBUG

	host = "." + host.toLowerCase();

	// Shortcuts
	if (
		dnsDomainIs(host, ".cn") ||

		false)
		return direct;

	// Common rules
	if (
		// X a.k.a. Twitter
		dnsDomainIs(host, ".twimg.com") ||
		dnsDomainIs(host, ".twitter.com") ||
		dnsDomainIs(host, ".t.co") ||
		dnsDomainIs(host, ".x.co") ||
		dnsDomainIs(host, ".x.com") ||
		dnsDomainIs(host, ".ads-twitter.com") ||

		// Google
		shExpMatch(host, "*.gstatic.*") ||
		dnsDomainIs(host, ".googleapis.com") ||
		shExpMatch(host, "*.google.*") ||
		dnsDomainIs(host, ".google") ||
		dnsDomainIs(host, ".googlevideo.com") ||
		dnsDomainIs(host, ".ytimg.com") ||
		dnsDomainIs(host, ".youtube.com") ||
		dnsDomainIs(host, ".ggpht.com") ||
		dnsDomainIs(host, ".googleusercontent.com") ||
		dnsDomainIs(host, ".g.co") ||
		dnsDomainIs(host, ".googledrive.com") ||
		dnsDomainIs(host, ".googletagmanager.com") ||
		dnsDomainIs(host, ".googletagservices.com") ||
		dnsDomainIs(host, ".google-analytics.com") ||
		dnsDomainIs(host, ".app-analytics-services.com") ||
		dnsDomainIs(host, ".crashlytics.com") ||
		dnsDomainIs(host, ".gvt3.com") ||
		dnsDomainIs(host, ".gvt2.com") ||
		dnsDomainIs(host, ".gvt1.com") ||
		dnsDomainIs(host, ".gvt0.com") ||
		shExpMatch(host, "*.doubleclick.*") ||
		dnsDomainIs(host, ".googleadservices.com") ||
		shExpMatch(host, "*.googleadsserving.*") ||
		dnsDomainIs(host, ".googlesyndication.com") ||
		dnsDomainIs(host, ".firebaseapp.com") ||
		dnsDomainIs(host, ".firebaseio.com") ||
		dnsDomainIs(host, ".recaptcha.net") ||
		dnsDomainIs(host, ".youtube-nocookie.com") ||
		dnsDomainIs(host, ".youtu.be") ||
		dnsDomainIs(host, ".goo.gl") ||
		dnsDomainIs(host, ".goo.gle") ||
		dnsDomainIs(host, ".goog") ||
		dnsDomainIs(host, ".gmail.com") ||
		dnsDomainIs(host, ".googlemail.com") ||
		dnsDomainIs(host, ".android.com") ||
		dnsDomainIs(host, ".chrome.com") ||
		dnsDomainIs(host, ".googleblog.com") ||
		shExpMatch(host, "*.blogspot.*") ||
		dnsDomainIs(host, ".blogger.com") ||
		dnsDomainIs(host, ".blogblog.com") ||
		dnsDomainIs(host, ".googlegroups.com") ||
		dnsDomainIs(host, ".googlesource.com") ||
		dnsDomainIs(host, ".waze.com") ||
		dnsDomainIs(host, ".appspot.com") ||
		dnsDomainIs(host, ".googlehosted.com") ||
		dnsDomainIs(host, ".googlelabs.com") ||
		dnsDomainIs(host, ".withgoogle.com") ||
		dnsDomainIs(host, ".thinkwithgoogle.com") ||

		// Apple
		dnsDomainIs(host, ".icloud.com") ||
		dnsDomainIs(host, ".icloud-content.com") ||
		dnsDomainIs(host, ".apple-cloudkit.com") ||
		dnsDomainIs(host, ".mzstatic.com") ||
		dnsDomainIs(host, ".cdn-apple.com") ||
		dnsDomainIs(host, ".apple-dns.net") ||
		dnsDomainIs(host, ".apple") ||

		// Yahoo!
		shExpMatch(host, "*.yimg.*") ||
		dnsDomainIs(host, ".yahooapis.com") ||
		shExpMatch(host, "*.yahoo.*") ||
		dnsDomainIs(host, ".yahoodns.net") ||
		dnsDomainIs(host, ".ymail.com") ||
		dnsDomainIs(host, ".yusercontent.com") ||
		dnsDomainIs(host, ".flickr.com") ||
		dnsDomainIs(host, ".staticflickr.com") ||
		dnsDomainIs(host, ".yahoosandbox.com") ||

		// Microsoft
		dnsDomainIs(host, ".live.com") ||
		dnsDomainIs(host, ".live.net") ||
		shExpMatch(host, "*.linkedin.*") ||
		shExpMatch(host, "*.github.*") ||
		dnsDomainIs(host, ".githubusercontent.com") ||
		dnsDomainIs(host, ".githubassets.com") ||
		dnsDomainIs(host, ".githubapp.com") ||
