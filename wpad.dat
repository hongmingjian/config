		dnsDomainIs(host, ".hk01.com") ||
		dnsDomainIs(host, ".zaobao.com") ||
		dnsDomainIs(host, ".chinadigitaltimes.net") ||
 		dnsDomainIs(host, ".v2ex.com") ||

		// Tools
		shExpMatch(host, "*.duckduckgo.*") ||
		dnsDomainIs(host, ".sstatic.net") ||
 		dnsDomainIs(host, ".openai.com") ||
 		dnsDomainIs(host, ".oaistatic.com") ||
 		dnsDomainIs(host, ".oaiusercontent.com") ||
 		dnsDomainIs(host, ".chatgpt.com") ||
 		dnsDomainIs(host, ".anthropic.com") ||
		dnsDomainIs(host, ".redd.it") ||
		dnsDomainIs(host, ".reddit.com") ||
 		dnsDomainIs(host, ".redditmedia.com") ||
 		dnsDomainIs(host, ".redditlist.com") ||
 		dnsDomainIs(host, ".redditstatic.com") ||
 		dnsDomainIs(host, ".redditspace.com") ||
 		dnsDomainIs(host, ".mozilla.org") ||
 		dnsDomainIs(host, ".mozilla.net") ||
 		dnsDomainIs(host, ".mozilla.com") ||
 		dnsDomainIs(host, ".firefox.com") ||
 		dnsDomainIs(host, ".mozgcp.net") ||
		shExpMatch(host, "*.wordpress.*") ||
		dnsDomainIs(host, ".wp.com") ||
		dnsDomainIs(host, ".gravatar.com") ||
		dnsDomainIs(host, ".dropbox.com") ||
		dnsDomainIs(host, ".dropboxusercontent.com") ||
		dnsDomainIs(host, ".dropboxstatic.com") ||
		dnsDomainIs(host, ".box.com") ||
		dnsDomainIs(host, ".pastebin.com") ||
		dnsDomainIs(host, ".imgur.com") ||
		dnsDomainIs(host, ".substack.com") ||
		shExpMatch(host, "*.z-library.*") ||
		shExpMatch(host, "*.cdn-zlib.*") ||
		shExpMatch(host, "*.go-to-library.*") ||
		shExpMatch(host, "*.singlelogin.*") ||
		dnsDomainIs(host, ".zlibrary-redirect.org") ||
		dnsDomainIs(host, ".quora.com") ||
 		dnsDomainIs(host, ".quoracdn.net") ||
		dnsDomainIs(host, ".ycombinator.com") ||
 		dnsDomainIs(host, ".medium.com") ||
		dnsDomainIs(host, ".ted.com") ||
 		dnsDomainIs(host, ".tedcdn.com") ||
		dnsDomainIs(host, ".pinterest.com") ||
 		dnsDomainIs(host, ".feedblitz.com") ||
		dnsDomainIs(host, ".vimeo.com") ||
		dnsDomainIs(host, ".vimeocdn.com") ||

		// Top level domains
		dnsDomainIs(host, ".org") ||
		dnsDomainIs(host, ".au") ||
		dnsDomainIs(host, ".sg") ||
		dnsDomainIs(host, ".io") ||
		dnsDomainIs(host, ".me") ||
