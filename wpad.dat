		host.match(/\.cnn\./) ||
		dnsDomainIs(host, ".reuters.com") ||
		dnsDomainIs(host, ".rfachina.com") ||
		dnsDomainIs(host, ".washingtonpost.com") ||
		host.match(/\.washpost\./) ||
