		dnsDomainIs(host, ".ru") ||
		dnsDomainIs(host, ".gg") ||
		dnsDomainIs(host, ".tv") ||
		dnsDomainIs(host, ".dj") ||
		dnsDomainIs(host, ".fm") ||
		dnsDomainIs(host, ".ly") ||
		dnsDomainIs(host, ".it") ||
		dnsDomainIs(host, ".vc") ||
