		dnsDomainIs(host, ".wiki") ||
		dnsDomainIs(host, ".media") ||
		dnsDomainIs(host, ".app") ||
		dnsDomainIs(host, ".biz") ||
		dnsDomainIs(host, ".tech") ||
		dnsDomainIs(host, ".icu") ||

		// CDN
		dnsDomainIs(host, ".akadns.net") ||
		dnsDomainIs(host, ".cloudflare-dns.com") ||
		dnsDomainIs(host, ".b-cdn.net") ||
		dnsDomainIs(host, ".bootstrapcdn.com") ||
		dnsDomainIs(host, ".dns-finder.com") ||

		// Google
		dnsDomainIs(host, ".g.co") ||
		dnsDomainIs(host, ".goo.gl") ||
		dnsDomainIs(host, ".goo.gle") ||
		shExpMatch(host, "*.google.*") ||
		dnsDomainIs(host, ".google") ||
